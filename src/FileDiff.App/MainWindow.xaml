<Window x:Class="FileDiff.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:infra="clr-namespace:FileDiff.App.Infrastructure"
        xmlns:controls="clr-namespace:FileDiff.App.Controls"
        xmlns:vm="clr-namespace:FileDiff.App.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="FileDiff — remember a folder, then see what changed"
        Width="1400" Height="880" MinWidth="1040" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource App.Background}"
        FontFamily="{DynamicResource Font.Ui}"
        Foreground="{DynamicResource App.Foreground}"
        UseLayoutRounding="True">
    <Window.InputBindings>
        <KeyBinding Key="F3" Command="{Binding QuickViewCommand}" />
        <KeyBinding Key="F4" Command="{Binding OpenSelectedFileCommand}" />
        <KeyBinding Key="F5" Command="{Binding CopySelectedCommand}" />
        <KeyBinding Key="F6" Command="{Binding MoveSelectedCommand}" />
        <KeyBinding Key="F7" Command="{Binding MkdirCommand}" />
        <KeyBinding Key="F8" Command="{Binding DeleteSelectedCommand}" />
        <KeyBinding Key="Return" Command="{Binding OpenSelectedFileCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:CountToVisibilityConverter x:Key="CountToVisibility" />
        <infra:NullToVisibilityConverter x:Key="NullToVisibility" />
        <infra:InverseBooleanConverter x:Key="InverseBoolean" />
        <infra:ChangeKindBrushConverter x:Key="KindBrush" />
        <infra:DiffLineBrushConverter x:Key="DiffLineBrush" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================ header ============================ -->
        <Border Grid.Row="0"
                Background="{DynamicResource App.Panel}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="7"
                            Background="{DynamicResource App.Accent}" Margin="0,0,11,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="Δ" FontSize="17" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="FileDiff" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="Take a snapshot of a folder — the next one tells you exactly what changed."
                                   Style="{DynamicResource Caption}" Margin="0,1,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding AppTheme, StringFormat=Theme: {0}}" Command="{Binding ToggleThemeCommand}"
                        VerticalAlignment="Center" ToolTip="Toggle Light/Dark theme" MinWidth="92" />
            </Grid>
        </Border>

        <!-- ============================ content ============================ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="378" MinWidth="320" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="460" />
            </Grid.ColumnDefinitions>

            <!-- left: controls -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="16,16,14,16">
                <StackPanel>

                    <TextBlock Text="FOLDER" Style="{DynamicResource SectionHeader}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Text="{Binding FolderPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="The folder to watch — type a path and press Enter">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding SnapshotNowCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}"
                                Margin="8,0,0,0" />
                    </Grid>

                    <TextBlock Text="{Binding FolderName, StringFormat=Watching: {0}}"
                               Style="{DynamicResource Caption}" Margin="0,7,0,0"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Margin="0,14,0,0"
                                Visibility="{Binding HasRecentFolders, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="RECENT" Style="{DynamicResource SectionHeader}" Margin="0,0,0,6" />
                        <ListBox ItemsSource="{Binding RecentFolders}"
                                 SelectedItem="{Binding SelectedRecentFolder, Mode=TwoWay}"
                                 MaxHeight="92"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{DynamicResource Mono}" FontSize="11.5"
                                               Foreground="{DynamicResource App.Muted}"
                                               TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>

                    <TextBlock Text="COMMANDER" Style="{DynamicResource SectionHeader}" Margin="0,18,0,6" />
                    <TextBlock Text="Second panel (F5/F6 target)" Style="{DynamicResource Caption}" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding SecondPanelPath, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Passive panel — pick with Browse or type a path" />
                        <Button Grid.Column="1" Content="⇄" Command="{Binding SwapPanelsCommand}"
                                Margin="8,0,0,0" ToolTip="Swap panels (Ctrl+U)" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Pin favorite (Ctrl+D)" Style="{DynamicResource SubtleButton}"
                                Command="{Binding ToggleFavoriteCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding FavoriteRoots}"
                             SelectedItem="{Binding SelectedFavorite, Mode=TwoWay}"
                             MaxHeight="92" Margin="0,6,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             ToolTip="Pinned favorites — click to open in active panel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{DynamicResource Mono}" FontSize="11.5"
                                           Foreground="{DynamicResource App.Muted}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Orientation="Horizontal" Margin="0,16,0,0" VerticalAlignment="Center">
                        <Button Content="Take snapshot"
                                Command="{Binding SnapshotNowCommand}"
                                Style="{DynamicResource PrimaryButton}"
                                MinWidth="126" Margin="0,0,8,4" />
                        <Button Content="Check changes"
                                Command="{Binding CheckChangesCommand}"
                                Margin="0,0,8,4" />
                        <Button Content="Cancel"
                                Command="{Binding CancelCommand}"
                                Margin="0,0,0,4"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>

                    <ProgressBar Height="4"
                                 Margin="0,12,0,0"
                                 BorderThickness="0"
                                 Background="{DynamicResource App.Sunken}"
                                 Foreground="{DynamicResource App.Accent}"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 IsIndeterminate="{Binding ProgressIndeterminate, Mode=OneWay}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding StatusText}"
                               Style="{DynamicResource Caption}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />

                    <!-- ====================== snapshots ====================== -->
                    <TextBlock Text="SNAPSHOTS" Style="{DynamicResource SectionHeader}" Margin="0,24,0,6" />
                    <TextBlock Text="{Binding StorageLabel}" Style="{DynamicResource Caption}" Margin="0,0,0,8" />

                    <TextBlock Text="{Binding EmptyStateMessage}"
                               TextWrapping="Wrap"
                               Style="{DynamicResource Caption}"
                               Visibility="{Binding EmptyStateMessage, Converter={StaticResource NullToVisibility}}" />

                    <ListBox ItemsSource="{Binding Snapshots}"
                             SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}"
                             MaxHeight="336"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent"
                             Visibility="{Binding HasSnapshots, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding TimeLabel}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" CornerRadius="6"
                                        Background="{DynamicResource App.Panel}"
                                        BorderBrush="{DynamicResource App.Border}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>
                                            <TextBlock Text="{Binding TimeLabel}" FontWeight="SemiBold"
                                                       FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding AgeLabel}" Style="{DynamicResource Caption}" />
                                            <TextBlock Text="{Binding DetailLabel}"
                                                       Style="{DynamicResource Caption}"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                    VerticalAlignment="Top" Margin="8,1,0,0">
                                            <Border Background="{DynamicResource App.Accent}" CornerRadius="4"
                                                    Padding="6,2" Margin="0,0,4,0"
                                                    Visibility="{Binding IsTarget, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="TARGET" FontSize="9.5" FontWeight="Bold"
                                                           Foreground="White" />
                                            </Border>
                                            <Border Background="{DynamicResource App.PanelAlt}" CornerRadius="4"
                                                    Padding="6,2" Margin="0,0,0,0"
                                                    BorderBrush="{DynamicResource App.BorderStrong}" BorderThickness="1"
                                                    Visibility="{Binding IsBaseline, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Text="BASELINE" FontSize="9.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource App.Muted}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                        <Button Content="Compare with previous" Style="{DynamicResource SubtleButton}"
                                Command="{Binding CompareWithPreviousCommand}" Margin="0,0,2,2" />
                        <Button Content="Set as baseline" Style="{DynamicResource SubtleButton}"
                                Command="{Binding SetAsBaselineCommand}" Margin="0,0,2,2" />
                        <Button Content="Swap" Style="{DynamicResource SubtleButton}"
                                Command="{Binding SwapComparisonCommand}" Margin="0,0,0,2" />
                    </WrapPanel>

                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Delete" Style="{DynamicResource SubtleButton}"
                                Command="{Binding DeleteSnapshotCommand}" Margin="0,0,2,2" />
                        <Button Content="Open folder" Style="{DynamicResource SubtleButton}"
                                Command="{Binding OpenSnapshotFolderCommand}" Margin="0,0,2,2" />
                        <Button Content="Refresh" Style="{DynamicResource SubtleButton}"
                                Command="{Binding RefreshCommand}" Margin="0,0,0,2" />
                    </WrapPanel>

                    <!-- ====================== notes ====================== -->
                    <Border Margin="0,20,0,0" Padding="12,10" CornerRadius="8"
                            Background="{DynamicResource App.Panel}"
                            BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
                        <StackPanel>
                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding NotesHeader}" Style="{DynamicResource SectionHeader}"
                                           VerticalAlignment="Center" Margin="0,0,0,0" />
                                <Button Grid.Column="1" Content="Clear done" Style="{DynamicResource SubtleButton}"
                                        Command="{Binding ClearDoneNotesCommand}"
                                        VerticalAlignment="Center" Padding="6,2" />
                            </Grid>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding NewNoteText, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalAlignment="Center" MinHeight="30"
                                         ToolTip="Type a note or to-do and press Enter">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding AddNoteCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="1" Content="Add" Command="{Binding AddNoteCommand}"
                                        Margin="8,0,0,0" MinWidth="56" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,8,0,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Reminder:" Style="{DynamicResource Caption}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <DatePicker Grid.Column="1" SelectedDate="{Binding NewNoteDueDate, Mode=TwoWay}"
                                            VerticalAlignment="Center"
                                            ToolTip="Optional due date — empty means plain note" />
                            </Grid>
                            <ListBox ItemsSource="{Binding Notes}"
                                     SelectedItem="{Binding SelectedNote, Mode=TwoWay}"
                                     MaxHeight="190" Margin="0,10,0,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse x:Name="Dot" Width="8" Height="8" Margin="2,6,8,0"
                                                     VerticalAlignment="Top" Fill="{DynamicResource App.Faint}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="NoteText" Text="{Binding Text}"
                                                           TextWrapping="Wrap" FontSize="12.5" />
                                                <TextBlock x:Name="DueText" Text="{Binding DueLabel}"
                                                           Style="{DynamicResource Caption}" FontSize="11"
                                                           Visibility="{Binding DueLabel, Converter={StaticResource NullToVisibility}}" />
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Kind.Added.Foreground}" />
                                                <Setter TargetName="NoteText" Property="Foreground" Value="{DynamicResource App.Muted}" />
                                                <Setter TargetName="NoteText" Property="TextDecorations" Value="Strikethrough" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource App.Danger}" />
                                                <Setter TargetName="DueText" Property="Foreground" Value="{DynamicResource App.Danger}" />
                                                <Setter TargetName="DueText" Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsDueToday}" Value="True">
                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource App.Accent}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <WrapPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                <Button Content="✓ Done" Style="{DynamicResource SubtleButton}"
                                        Command="{Binding ToggleNoteCommand}" Margin="0,0,2,2" />
                                <Button Content="Delete" Style="{DynamicResource SubtleButton}"
                                        Command="{Binding DeleteNoteCommand}" Margin="0,0,0,2" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- ====================== settings ====================== -->
                    <Button Content="Settings ▾" Style="{DynamicResource SubtleButton}"
                            Command="{Binding ToggleSettingsCommand}"
                            HorizontalAlignment="Left" Margin="0,18,0,0" />

                    <StackPanel Margin="0,8,0,0"
                                Visibility="{Binding SettingsExpanded, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox Content="Capture file content (enables line-by-line diffs)"
                                  IsChecked="{Binding CaptureContent, Mode=TwoWay}" />
                        <CheckBox Content="Include hidden and system files"
                                  IsChecked="{Binding IncludeHiddenFiles, Mode=TwoWay}"
                                  Margin="0,9,0,0" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="74" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Diff context lines" Style="{DynamicResource Caption}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Text="{Binding ContextLinesText, UpdateSourceTrigger=LostFocus}"
                                     HorizontalContentAlignment="Right" />

                            <TextBlock Grid.Row="1" Text="Keep this many snapshots"
                                       Style="{DynamicResource Caption}" VerticalAlignment="Center" Margin="0,9,8,0" />
                            <TextBox Grid.Row="1" Grid.Column="1"
                                     Text="{Binding KeepSnapshotsText, UpdateSourceTrigger=LostFocus}"
                                     Margin="0,9,0,0" HorizontalContentAlignment="Right" />

                            <TextBlock Grid.Row="2" Text="Capture content up to (MB)"
                                       Style="{DynamicResource Caption}" VerticalAlignment="Center" Margin="0,9,8,0" />
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Text="{Binding MaxContentMegabytesText, UpdateSourceTrigger=LostFocus}"
                                     Margin="0,9,0,0" HorizontalContentAlignment="Right" />
                        </Grid>

                        <TextBlock Text="EXTRA IGNORE RULES" Style="{DynamicResource SectionHeader}"
                                   Margin="0,16,0,6" />
                        <TextBox Text="{Binding IgnorePatternsText, UpdateSourceTrigger=LostFocus}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="72"
                                 MaxHeight="140"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 FontFamily="{DynamicResource Font.Mono}"
                                 FontSize="11.5"
                                 ToolTip="One glob per line, for example: *.log  or  coverage/" />
                        <TextBlock Text="{Binding IgnoreRuleCountLabel}"
                                   Style="{DynamicResource Caption}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Clean up data" Style="{DynamicResource SubtleButton}"
                                    Command="{Binding CleanupCommand}" />
                            <Button Content="App data folder" Style="{DynamicResource SubtleButton}"
                                    Command="{Binding OpenLogFolderCommand}" Margin="6,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="1" Width="6"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource App.Border}" />

            <!-- right: results -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="150" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="180" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource App.Panel}"
                        BorderBrush="{DynamicResource App.Border}"
                        BorderThickness="0,0,0,1"
                        Padding="18,13,18,12">
                    <StackPanel>
                        <TextBlock Text="{Binding CompareHeader}" FontSize="14" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SummaryLine}" Style="{DynamicResource Caption}"
                                   TextWrapping="Wrap" Margin="0,5,0,0" />

                        <Border Background="{DynamicResource Kind.Moved.Background}" CornerRadius="5"
                                Padding="9,5" Margin="0,9,0,0" HorizontalAlignment="Left"
                                Visibility="{Binding IsLiveComparison, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="This comparison uses a live scan — nothing was added to the timeline. Press Take snapshot to keep it."
                                       FontSize="11.5"
                                       Foreground="{DynamicResource Kind.Moved.Foreground}" />
                        </Border>

                        <WrapPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center"
                                     Visibility="{Binding HasDiff, Converter={StaticResource BoolToVisibility}}">
                            <Border Background="{DynamicResource Kind.Added.Background}" CornerRadius="999"
                                    Padding="11,4" Margin="0,0,6,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding AddedCount}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Kind.Added.Foreground}" />
                                    <TextBlock Text=" added" Foreground="{DynamicResource Kind.Added.Foreground}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource Kind.Modified.Background}" CornerRadius="999"
                                    Padding="11,4" Margin="0,0,6,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding ModifiedCount}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Kind.Modified.Foreground}" />
                                    <TextBlock Text=" modified" Foreground="{DynamicResource Kind.Modified.Foreground}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource Kind.Removed.Background}" CornerRadius="999"
                                    Padding="11,4" Margin="0,0,6,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding RemovedCount}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Kind.Removed.Foreground}" />
                                    <TextBlock Text=" deleted" Foreground="{DynamicResource Kind.Removed.Foreground}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource Kind.Moved.Background}" CornerRadius="999"
                                    Padding="11,4" Margin="0,0,6,4" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding MovedCount}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Kind.Moved.Foreground}" />
                                    <TextBlock Text=" moved" Foreground="{DynamicResource Kind.Moved.Foreground}" />
                                </StackPanel>
                            </Border>
                            <Border Background="{DynamicResource App.PanelAlt}" CornerRadius="999"
                                    Padding="11,4" Margin="0,0,6,4" VerticalAlignment="Center"
                                    BorderBrush="{DynamicResource App.Border}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding UnchangedCount}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource App.Muted}" />
                                    <TextBlock Text=" unchanged" Foreground="{DynamicResource App.Muted}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- ====================== toolbar ====================== -->
                <Grid Grid.Row="1" Margin="18,11,18,7" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ToggleButton Style="{DynamicResource FilterChip}"
                                      IsChecked="{Binding ShowAdded, Mode=TwoWay}"
                                      Content="added" VerticalAlignment="Center" />
                        <ToggleButton Style="{DynamicResource FilterChip}"
                                      IsChecked="{Binding ShowModified, Mode=TwoWay}"
                                      Content="modified" VerticalAlignment="Center" />
                        <ToggleButton Style="{DynamicResource FilterChip}"
                                      IsChecked="{Binding ShowRemoved, Mode=TwoWay}"
                                      Content="deleted" VerticalAlignment="Center" />
                        <ToggleButton Style="{DynamicResource FilterChip}"
                                      IsChecked="{Binding ShowMoved, Mode=TwoWay}"
                                      Content="moved" VerticalAlignment="Center" />

                        <TextBox Width="196" Margin="12,0,0,0" MinHeight="30"
                                 VerticalAlignment="Center" VerticalContentAlignment="Center"
                                 Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Filter the changed files by path" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Export patch" Command="{Binding ExportPatchCommand}" VerticalAlignment="Center" />
                        <Button Content="HTML report" Command="{Binding ExportHtmlCommand}" Margin="6,0,0,0" VerticalAlignment="Center" />
                        <Button Content="CSV" Command="{Binding ExportCsvCommand}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" Margin="18,0,18,7" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="F3 View" Command="{Binding QuickViewCommand}" ToolTip="Quick view selected file" Margin="0,0,6,4" VerticalAlignment="Center" />
                        <Button Content="F4 Open" Command="{Binding OpenSelectedFileCommand}" Margin="0,0,6,4" ToolTip="Open with associated app (Enter)" VerticalAlignment="Center" />
                        <Button Content="F5 Copy" Command="{Binding CopySelectedCommand}" Margin="0,0,6,4" ToolTip="Copy to second panel" VerticalAlignment="Center" />
                        <Button Content="F6 Move" Command="{Binding MoveSelectedCommand}" Margin="0,0,6,4" ToolTip="Move to second panel" VerticalAlignment="Center" />
                        <Button Content="Rename" Command="{Binding RenameSelectedCommand}" Margin="0,0,6,4" VerticalAlignment="Center" />
                        <Button Content="F7 Mkdir" Command="{Binding MkdirCommand}" Margin="0,0,6,4" VerticalAlignment="Center" />
                        <Button Content="F8 Del" Command="{Binding DeleteSelectedCommand}" Margin="0,0,0,4" ToolTip="Delete from disk" VerticalAlignment="Center" />
                    </WrapPanel>
                    <TextBox Grid.Column="1" Width="220" MinHeight="30" Margin="12,0,0,4"
                             VerticalAlignment="Center" VerticalContentAlignment="Center"
                             Text="{Binding SecondPanelPath, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Second panel folder — F5/F6 copy here. Ctrl+U swaps panels." />
                </Grid>

                <!-- ====================== changed files ====================== -->
                <Grid Grid.Row="3" Margin="18,0,18,6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding ChangesHeader}"
                               Style="{DynamicResource SectionHeader}" Margin="0,0,0,7" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Changes}"
                             SelectedItem="{Binding SelectedChange, Mode=TwoWay}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Background="Transparent">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Path}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,7" CornerRadius="6" BorderThickness="1"
                                        Background="{DynamicResource App.Panel}"
                                        BorderBrush="{DynamicResource App.Border}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Background="{Binding Kind, Converter={StaticResource KindBrush}, ConverterParameter=Background}"
                                                CornerRadius="4" Padding="7,2" MinWidth="64"
                                                VerticalAlignment="Center" Margin="0,1,10,0">
                                            <TextBlock Text="{Binding KindLabel}" FontSize="9.5" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Foreground="{Binding Kind, Converter={StaticResource KindBrush}, ConverterParameter=Foreground}" />
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Path}" FontWeight="SemiBold" FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MovedFromLabel}"
                                                       Style="{DynamicResource Caption}" FontSize="11"
                                                       Visibility="{Binding MovedFromLabel, Converter={StaticResource NullToVisibility}}" />
                                            <TextBlock Text="{Binding TimestampLabel}"
                                                       Style="{DynamicResource Caption}" FontSize="11"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock Text="{Binding LinesLabel}"
                                                       Style="{DynamicResource Mono}" FontSize="11.5"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource App.Muted}" />
                                            <TextBlock Text="{Binding SizeLabel}"
                                                       Style="{DynamicResource Caption}" FontSize="11"
                                                       HorizontalAlignment="Right" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,0,0,34" TextWrapping="Wrap" TextAlignment="Center"
                               Style="{DynamicResource Caption}"
                               Text="No differences — every file matches the baseline."
                               Visibility="{Binding HasNoChanges, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,0,0,34" TextWrapping="Wrap" TextAlignment="Center"
                               Style="{DynamicResource Caption}"
                               Text="No changed files match the current filter."
                               Visibility="{Binding EverythingFilteredOut, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <GridSplitter Grid.Row="4" Height="6"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              Background="{DynamicResource App.Border}" />

                <!-- ====================== diff pane ====================== -->
                <Grid Grid.Row="5" Margin="18,6,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="{Binding DocumentHeader}" FontSize="13.5" FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DocumentSubHeader}" Style="{DynamicResource Caption}"
                                   TextWrapping="Wrap" Margin="0,3,0,0" />

                        <ItemsControl ItemsSource="{Binding DocumentNotes}" Margin="0,7,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Kind.Modified.Foreground}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="{Binding DocumentUnavailableReason}"
                                   FontSize="11.5" FontStyle="Italic" TextWrapping="Wrap" Margin="0,7,0,0"
                                   Foreground="{DynamicResource App.Muted}"
                                   Visibility="{Binding HasDocumentNote, Converter={StaticResource BoolToVisibility}}" />
                        <Border Margin="0,7,0,0" Padding="9,7" CornerRadius="5"
                                Background="{DynamicResource App.Sunken}"
                                Visibility="{Binding HasQuickView, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Quick View (F3)" FontWeight="SemiBold" FontSize="11.5" />
                                    <Button Content="Close" Style="{DynamicResource SubtleButton}"
                                            Command="{Binding ClearQuickViewCommand}" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBox Grid.Row="1" Text="{Binding QuickViewText, Mode=OneWay}"
                                         FontFamily="{DynamicResource Font.Mono}" FontSize="11.5"
                                         IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Style="{DynamicResource Caption}" TextWrapping="Wrap" TextAlignment="Center"
                               Text="Nothing to show for this entry — its content did not change."
                               Visibility="{Binding ShowNoContentMessage, Converter={StaticResource BoolToVisibility}}" />

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding DiffLines}"
                             Margin="0,8,0,0"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock x:Name="HunkRow"
                                               Text="{Binding Header}"
                                               FontFamily="{DynamicResource Font.Mono}" FontSize="11.5"
                                               Foreground="{DynamicResource Diff.Hunk.Foreground}"
                                               Margin="4,7,4,3" />

                                    <Grid x:Name="LineRow"
                                          Background="{Binding Kind, Converter={StaticResource DiffLineBrush}, ConverterParameter=Background}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding OldNumber}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,8,0"
                                                   FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                                                   Foreground="{DynamicResource Diff.Gutter.Foreground}" />
                                        <TextBlock Grid.Column="1" Text="{Binding NewNumber}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,8,0"
                                                   FontFamily="{DynamicResource Font.Mono}" FontSize="10.5"
                                                   Foreground="{DynamicResource Diff.Gutter.Foreground}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Marker}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"
                                                   FontFamily="{DynamicResource Font.Mono}" FontSize="12"
                                                   Foreground="{Binding Kind, Converter={StaticResource DiffLineBrush}, ConverterParameter=Foreground}" />

                                        <controls:EmphasisText Grid.Column="3"
                                                   Text="{Binding Text}"
                                                   Prefix="{Binding Prefix}"
                                                   Emphasis="{Binding Emphasis}"
                                                   Suffix="{Binding Suffix}"
                                                   HasEmphasis="{Binding HasEmphasis}"
                                                   Margin="0,2,8,4"
                                                   Foreground="{Binding Kind, Converter={StaticResource DiffLineBrush}, ConverterParameter=Foreground}" />
                                    </Grid>
                                </Grid>

                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHunkHeader}" Value="True">
                                        <Setter TargetName="HunkRow" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="LineRow" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

            </Grid>
        </Grid>

        <!-- ============================ status bar ============================ -->
        <Border Grid.Row="2"
                Background="{DynamicResource App.Panel}"
                BorderBrush="{DynamicResource App.Border}"
                BorderThickness="0,1,0,0"
                Padding="18,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding FolderPath}" Style="{DynamicResource Caption}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding VersionLabel}" Style="{DynamicResource Caption}" />
            </Grid>
        </Border>
    </Grid>
</Window>





