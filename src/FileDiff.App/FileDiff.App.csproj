<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FileDiff.Core\FileDiff.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>

    <!-- Makes this look like a real application in Explorer, the task bar and Alt+Tab. -->
    <ApplicationIcon>Assets\FileDiff.ico</ApplicationIcon>
    <Product>FileDiff</Product>
    <AssemblyTitle>FileDiff</AssemblyTitle>
    <Description>Remember the state of a folder, then see exactly what changed.</Description>
    <Company>FileDiff</Company>
    <Version>1.0.0</Version>
    <Copyright>Local tool. No data ever leaves this machine.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF does not pick up .ico by default when building from a directory. -->
    <Resource Include="Assets\FileDiff.ico" />
  </ItemGroup>

</Project>
