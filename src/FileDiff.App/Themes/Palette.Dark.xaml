<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ palette ============ -->
    <SolidColorBrush x:Key="App.Background" Color="#0F1116" />
    <SolidColorBrush x:Key="App.Panel" Color="#161A22" />
    <SolidColorBrush x:Key="App.PanelAlt" Color="#1B2029" />
    <SolidColorBrush x:Key="App.Sunken" Color="#0B0D12" />
    <SolidColorBrush x:Key="App.Border" Color="#232936" />
    <SolidColorBrush x:Key="App.BorderStrong" Color="#333C4D" />
    <SolidColorBrush x:Key="App.Foreground" Color="#E6E9EF" />
    <SolidColorBrush x:Key="App.Muted" Color="#98A2B3" />
    <SolidColorBrush x:Key="App.Faint" Color="#6B7488" />
    <SolidColorBrush x:Key="App.Accent" Color="#3B82F6" />
    <SolidColorBrush x:Key="App.AccentHover" Color="#5A97FF" />
    <SolidColorBrush x:Key="App.AccentPressed" Color="#2C6AD4" />
    <SolidColorBrush x:Key="App.Danger" Color="#F87171" />
    <SolidColorBrush x:Key="App.Hover" Color="#232A36" />
    <SolidColorBrush x:Key="App.Selected" Color="#1D283C" />
    <SolidColorBrush x:Key="App.Focus" Color="#3B82F6" />

    <!-- change-kind badges -->
    <SolidColorBrush x:Key="Kind.Added.Background" Color="#12291C" />
    <SolidColorBrush x:Key="Kind.Added.Foreground" Color="#7EE2A8" />
    <SolidColorBrush x:Key="Kind.Removed.Background" Color="#2C1418" />
    <SolidColorBrush x:Key="Kind.Removed.Foreground" Color="#FF9AA6" />
    <SolidColorBrush x:Key="Kind.Modified.Background" Color="#2A2410" />
    <SolidColorBrush x:Key="Kind.Modified.Foreground" Color="#FFD479" />
    <SolidColorBrush x:Key="Kind.Moved.Background" Color="#12203A" />
    <SolidColorBrush x:Key="Kind.Moved.Foreground" Color="#8FC7FF" />

    <!-- diff line roles -->
    <SolidColorBrush x:Key="Diff.Added.Background" Color="#12291C" />
    <SolidColorBrush x:Key="Diff.Added.Foreground" Color="#9BEFBE" />
    <SolidColorBrush x:Key="Diff.Removed.Background" Color="#2C1418" />
    <SolidColorBrush x:Key="Diff.Removed.Foreground" Color="#FFAEB8" />
    <SolidColorBrush x:Key="Diff.Context.Background" Color="#141821" />
    <SolidColorBrush x:Key="Diff.Context.Foreground" Color="#C3CAD6" />
    <SolidColorBrush x:Key="Diff.Hunk.Foreground" Color="#7C8BA1" />
    <SolidColorBrush x:Key="Diff.Emphasis" Color="#FFFFFF45" />
    <SolidColorBrush x:Key="Diff.Gutter.Foreground" Color="#5C6675" />

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ============ text ============ -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource App.Foreground}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource App.Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource App.Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource App.Foreground}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

</ResourceDictionary>
