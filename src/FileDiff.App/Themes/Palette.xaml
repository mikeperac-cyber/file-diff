<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ palette (Light) ============ -->
    <SolidColorBrush x:Key="App.Background" Color="#F1F3F7" />
    <SolidColorBrush x:Key="App.Panel" Color="#FFFFFF" />
    <SolidColorBrush x:Key="App.PanelAlt" Color="#EDF0F5" />
    <SolidColorBrush x:Key="App.Sunken" Color="#E6EAF1" />
    <SolidColorBrush x:Key="App.Border" Color="#D8DEE8" />
    <SolidColorBrush x:Key="App.BorderStrong" Color="#B7C1D2" />
    <SolidColorBrush x:Key="App.Foreground" Color="#17202F" />
    <SolidColorBrush x:Key="App.Muted" Color="#5B667A" />
    <SolidColorBrush x:Key="App.Faint" Color="#8B95A9" />
    <SolidColorBrush x:Key="App.Accent" Color="#2563EB" />
    <SolidColorBrush x:Key="App.AccentHover" Color="#1D4ED8" />
    <SolidColorBrush x:Key="App.AccentPressed" Color="#1E40AF" />
    <SolidColorBrush x:Key="App.Danger" Color="#DC2626" />
    <SolidColorBrush x:Key="App.Hover" Color="#E7ECF3" />
    <SolidColorBrush x:Key="App.Selected" Color="#DBEAFE" />
    <SolidColorBrush x:Key="App.Focus" Color="#2563EB" />

    <!-- change-kind badges -->
    <SolidColorBrush x:Key="Kind.Added.Background" Color="#DDF5E5" />
    <SolidColorBrush x:Key="Kind.Added.Foreground" Color="#0E7A3D" />
    <SolidColorBrush x:Key="Kind.Removed.Background" Color="#FBE1E5" />
    <SolidColorBrush x:Key="Kind.Removed.Foreground" Color="#B4232B" />
    <SolidColorBrush x:Key="Kind.Modified.Background" Color="#FFF0C2" />
    <SolidColorBrush x:Key="Kind.Modified.Foreground" Color="#8A6100" />
    <SolidColorBrush x:Key="Kind.Moved.Background" Color="#D9E9FF" />
    <SolidColorBrush x:Key="Kind.Moved.Foreground" Color="#1D4ED8" />

    <!-- diff line roles -->
    <SolidColorBrush x:Key="Diff.Added.Background" Color="#E3F5E9" />
    <SolidColorBrush x:Key="Diff.Added.Foreground" Color="#14532D" />
    <SolidColorBrush x:Key="Diff.Removed.Background" Color="#FCECEF" />
    <SolidColorBrush x:Key="Diff.Removed.Foreground" Color="#991B1B" />
    <SolidColorBrush x:Key="Diff.Context.Background" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Diff.Context.Foreground" Color="#334155" />
    <SolidColorBrush x:Key="Diff.Hunk.Foreground" Color="#64748B" />
    <SolidColorBrush x:Key="Diff.Emphasis" Color="#FDE68A" />
    <SolidColorBrush x:Key="Diff.Gutter.Foreground" Color="#94A3B8" />

    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- ============ text ============ -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource App.Foreground}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource App.Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource App.Muted}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Ui}" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style x:Key="Mono" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource App.Foreground}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

</ResourceDictionary>
